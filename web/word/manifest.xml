<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>6f1c2a4e-8b3d-4c57-9e21-5a7d0b9c3f10</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Wordtick</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Wordtick"/>
  <Description DefaultValue="Convert words to time: see how long your document takes to read aloud or silently."/>
  <IconUrl DefaultValue="https://wordtick.vercel.app/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://wordtick.vercel.app/icon-128.png"/>
  <SupportUrl DefaultValue="https://wordtick.vercel.app/privacy.html"/>
  <AppDomains><AppDomain>https://wordtick.vercel.app</AppDomain></AppDomains>
  <Hosts><Host Name="Document"/></Hosts>
  <DefaultSettings><SourceLocation DefaultValue="https://wordtick.vercel.app/word/taskpane.html"/></DefaultSettings>
  <Permissions>ReadDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts><Host xsi:type="Document"><DesktopFormFactor><GetStarted>
      <Title resid="T"/><Description resid="D"/><LearnMoreUrl resid="U"/></GetStarted>
      <ExtensionPoint xsi:type="PrimaryCommandSurface"><OfficeTab id="TabHome"><Group id="G">
        <Label resid="T"/><Icon><bt:Image size="16" resid="I16"/><bt:Image size="32" resid="I32"/><bt:Image size="80" resid="I80"/></Icon>
        <Control xsi:type="Button" id="B"><Label resid="T"/><Supertip><Title resid="T"/><Description resid="D"/></Supertip>
          <Icon><bt:Image size="16" resid="I16"/><bt:Image size="32" resid="I32"/><bt:Image size="80" resid="I80"/></Icon>
          <Action xsi:type="ShowTaskpane"><TaskpaneId>P</TaskpaneId><SourceLocation resid="P"/></Action></Control>
      </Group></OfficeTab></ExtensionPoint></DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="I16" DefaultValue="https://wordtick.vercel.app/icon-16.png"/><bt:Image id="I32" DefaultValue="https://wordtick.vercel.app/icon-32.png"/><bt:Image id="I80" DefaultValue="https://wordtick.vercel.app/icon-80.png"/></bt:Images>
      <bt:Urls><bt:Url id="P" DefaultValue="https://wordtick.vercel.app/word/taskpane.html"/><bt:Url id="U" DefaultValue="https://wordtick.vercel.app/"/></bt:Urls>
      <bt:ShortStrings><bt:String id="T" DefaultValue="Wordtick"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="D" DefaultValue="How long will your document take to read aloud or silently?"/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
